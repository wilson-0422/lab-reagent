<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>编辑试剂 - 实验室试剂与仪器管控平台</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">实验室管控平台</a></div>
    <div class="nav-links">
      <a href="/dashboard">首页</a>
      <a href="/reagents" class="active">试剂管理</a>
      <a href="/hazards">危化品台账</a>
      <a href="/instruments">仪器预约</a>
      <a href="/experiments">实验记录</a>
    </div>
    <div class="nav-user">
      <span class="user-info"><%= session.realName %></span>
      <a href="/auth/logout" class="btn-logout">退出</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <h1>编辑试剂 - <%= reagent.name %></h1>
      <a href="/reagents/<%= reagent.id %>" class="btn">返回详情</a>
    </div>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/reagents/<%= reagent.id %>/edit" method="POST" class="form-card">
      <div class="form-group">
        <label for="name">试剂名称 <span class="required">*</span></label>
        <input type="text" id="name" name="name" required value="<%= reagent.name %>">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="cas_number">CAS号</label>
          <input type="text" id="cas_number" name="cas_number" value="<%= reagent.cas_number || '' %>">
        </div>
        <div class="form-group">
          <label for="category">分类 <span class="required">*</span></label>
          <select id="category" name="category" required>
            <option value="">请选择分类</option>
            <option value="无机酸" <%= reagent.category === '无机酸' ? 'selected' : '' %>>无机酸</option>
            <option value="无机碱" <%= reagent.category === '无机碱' ? 'selected' : '' %>>无机碱</option>
            <option value="无机盐" <%= reagent.category === '无机盐' ? 'selected' : '' %>>无机盐</option>
            <option value="有机溶剂" <%= reagent.category === '有机溶剂' ? 'selected' : '' %>>有机溶剂</option>
            <option value="有机试剂" <%= reagent.category === '有机试剂' ? 'selected' : '' %>>有机试剂</option>
            <option value="指示剂" <%= reagent.category === '指示剂' ? 'selected' : '' %>>指示剂</option>
            <option value="标准品" <%= reagent.category === '标准品' ? 'selected' : '' %>>标准品</option>
            <option value="其他" <%= reagent.category === '其他' ? 'selected' : '' %>>其他</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="specification">规格</label>
          <input type="text" id="specification" name="specification" value="<%= reagent.specification || '' %>">
        </div>
        <div class="form-group">
          <label for="unit">单位 <span class="required">*</span></label>
          <input type="text" id="unit" name="unit" required value="<%= reagent.unit %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="stock_quantity">库存数量</label>
          <input type="number" id="stock_quantity" name="stock_quantity" min="0" value="<%= reagent.stock_quantity %>">
        </div>
        <div class="form-group">
          <label for="min_quantity">最低库存</label>
          <input type="number" id="min_quantity" name="min_quantity" min="0" value="<%= reagent.min_quantity %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="location">存放位置</label>
          <input type="text" id="location" name="location" value="<%= reagent.location || '' %>">
        </div>
        <div class="form-group">
          <label for="supplier">供应商</label>
          <input type="text" id="supplier" name="supplier" value="<%= reagent.supplier || '' %>">
        </div>
      </div>
      <div class="form-group">
        <label for="price">单价(元)</label>
        <input type="number" id="price" name="price" step="0.01" min="0" value="<%= reagent.price || '' %>">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">保存</button>
        <a href="/reagents/<%= reagent.id %>" class="btn">取消</a>
      </div>
    </form>
  </main>
  <footer class="footer"><p>&copy; 2026 实验室试剂与仪器管控平台</p></footer>
</body>
</html>
