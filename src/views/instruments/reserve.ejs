<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>预约 <%= instrument.name %> - 实验室试剂与仪器管控平台</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">实验室管控平台</a></div>
    <div class="nav-links">
      <a href="/dashboard">首页</a>
      <a href="/reagents">试剂管理</a>
      <a href="/hazards">危化品台账</a>
      <a href="/instruments" class="active">仪器预约</a>
      <a href="/experiments">实验记录</a>
    </div>
    <div class="nav-user">
      <span class="user-info"><%= session.realName %></span>
      <a href="/auth/logout" class="btn-logout">退出</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <h1>预约 <%= instrument.name %></h1>
      <a href="/instruments/<%= instrument.id %>" class="btn">返回详情</a>
    </div>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <div class="detail-card" style="margin-bottom: 20px;">
      <p><strong>仪器名称：</strong><%= instrument.name %></p>
      <p><strong>型号：</strong><%= instrument.model || '-' %></p>
      <p><strong>位置：</strong><%= instrument.location || '-' %></p>
    </div>
    <form action="/instruments/<%= instrument.id %>/reserve" method="POST" class="form-card">
      <div class="form-row">
        <div class="form-group">
          <label for="start_time">开始时间 <span class="required">*</span></label>
          <input type="datetime-local" id="start_time" name="start_time" required>
        </div>
        <div class="form-group">
          <label for="end_time">结束时间 <span class="required">*</span></label>
          <input type="datetime-local" id="end_time" name="end_time" required>
        </div>
      </div>
      <div class="form-group">
        <label for="purpose">使用目的</label>
        <textarea id="purpose" name="purpose" rows="3" placeholder="请简要说明使用目的"></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">提交预约</button>
        <a href="/instruments/<%= instrument.id %>" class="btn">取消</a>
      </div>
    </form>
  </main>
  <footer class="footer"><p>&copy; 2026 实验室试剂与仪器管控平台</p></footer>
</body>
</html>
