<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>仪器预约 - 实验室试剂与仪器管控平台</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">实验室管控平台</a></div>
    <div class="nav-links">
      <a href="/dashboard">首页</a>
      <a href="/reagents">试剂管理</a>
      <a href="/hazards">危化品台账</a>
      <a href="/instruments" class="active">仪器预约</a>
      <a href="/experiments">实验记录</a>
    </div>
    <div class="nav-user">
      <span class="user-info"><%= session.realName %></span>
      <a href="/auth/logout" class="btn-logout">退出</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <h1>仪器预约</h1>
    </div>
    <table class="data-table">
      <thead>
        <tr>
          <th>编号</th>
          <th>仪器名称</th>
          <th>型号</th>
          <th>制造商</th>
          <th>分类</th>
          <th>位置</th>
          <th>状态</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% instruments.forEach(function(inst) { %>
          <tr>
            <td><%= inst.id %></td>
            <td><a href="/instruments/<%= inst.id %>"><%= inst.name %></a></td>
            <td><%= inst.model || '-' %></td>
            <td><%= inst.manufacturer || '-' %></td>
            <td><%= inst.category %></td>
            <td><%= inst.location || '-' %></td>
            <td><span class="badge <%= inst.status === '正常' ? 'badge-success' : inst.status === '维修中' ? 'badge-danger' : 'badge-warning' %>"><%= inst.status %></span></td>
            <td>
              <a href="/instruments/<%= inst.id %>" class="btn btn-sm">详情</a>
              <% if (inst.status === '正常') { %>
                <a href="/instruments/<%= inst.id %>/reserve" class="btn btn-sm btn-primary">预约</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (instruments.length === 0) { %>
          <tr><td colspan="8" class="text-center">暂无仪器数据</td></tr>
        <% } %>
      </tbody>
    </table>
  </main>
  <footer class="footer"><p>&copy; 2026 实验室试剂与仪器管控平台</p></footer>
</body>
</html>
