<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>系统首页 - 实验室试剂与仪器管控平台</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">实验室管控平台</a></div>
    <div class="nav-links">
      <a href="/dashboard" class="active">首页</a>
      <a href="/reagents">试剂管理</a>
      <a href="/hazards">危化品台账</a>
      <a href="/instruments">仪器预约</a>
      <a href="/experiments">实验记录</a>
    </div>
    <div class="nav-user">
      <span class="user-info"><%= session.realName %></span>
      <a href="/auth/logout" class="btn-logout">退出</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <h1>系统概览</h1>
    </div>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number"><%= reagentCount %></div>
        <div class="stat-label">试剂总数</div>
        <a href="/reagents" class="stat-link">查看详情</a>
      </div>
      <div class="stat-card stat-card-warning">
        <div class="stat-number"><%= hazardCount %></div>
        <div class="stat-label">危化品种类</div>
        <a href="/hazards" class="stat-link">查看详情</a>
      </div>
      <div class="stat-card stat-card-info">
        <div class="stat-number"><%= instrumentCount %></div>
        <div class="stat-label">仪器设备</div>
        <a href="/instruments" class="stat-link">查看详情</a>
      </div>
      <div class="stat-card stat-card-success">
        <div class="stat-number"><%= experimentCount %></div>
        <div class="stat-label">实验记录</div>
        <a href="/experiments" class="stat-link">查看详情</a>
      </div>
    </div>

    <div class="dashboard-grid">
      <div class="dashboard-section">
        <h2>库存预警</h2>
        <% if (lowStockReagents.length > 0) { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>试剂名称</th>
                <th>当前库存</th>
                <th>最低库存</th>
                <th>状态</th>
              </tr>
            </thead>
            <tbody>
              <% lowStockReagents.forEach(function(r) { %>
                <tr>
                  <td><a href="/reagents/<%= r.id %>"><%= r.name %></a></td>
                  <td class="text-danger"><%= r.stock_quantity %></td>
                  <td><%= r.min_quantity %></td>
                  <td><span class="badge badge-warning"><%= r.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <p class="text-center">所有试剂库存正常</p>
        <% } %>
      </div>

      <div class="dashboard-section">
        <h2>待处理事项</h2>
        <div class="todo-list">
          <div class="todo-item">
            <span class="todo-label">待确认预约</span>
            <span class="todo-count"><%= pendingReservations %></span>
          </div>
          <div class="todo-item">
            <span class="todo-label">草稿实验记录</span>
            <span class="todo-count"><%= draftExperiments %></span>
          </div>
          <div class="todo-item">
            <span class="todo-label">库存预警试剂</span>
            <span class="todo-count"><%= lowStockReagents.length %></span>
          </div>
        </div>
      </div>
    </div>
  </main>
  <footer class="footer"><p>&copy; 2026 实验室试剂与仪器管控平台</p></footer>
</body>
</html>
