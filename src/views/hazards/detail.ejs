<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= hazard.name %> - 危化品详情 - 实验室试剂与仪器管控平台</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">实验室管控平台</a></div>
    <div class="nav-links">
      <a href="/dashboard">首页</a>
      <a href="/reagents">试剂管理</a>
      <a href="/hazards" class="active">危化品台账</a>
      <a href="/instruments">仪器预约</a>
      <a href="/experiments">实验记录</a>
    </div>
    <div class="nav-user">
      <span class="user-info"><%= session.realName %></span>
      <a href="/auth/logout" class="btn-logout">退出</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <h1><%= hazard.name %></h1>
      <a href="/hazards" class="btn">返回列表</a>
    </div>
    <div class="detail-card">
      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">CAS号</span>
          <span class="detail-value"><%= hazard.cas_number || '-' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">危险分类</span>
          <span class="detail-value"><span class="badge badge-danger"><%= hazard.hazard_class %></span></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">UN编号</span>
          <span class="detail-value"><%= hazard.un_number || '-' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">库存数量</span>
          <span class="detail-value"><%= hazard.stock_quantity %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">存放位置</span>
          <span class="detail-value"><%= hazard.location || '-' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">责任人</span>
          <span class="detail-value"><%= hazard.supervisor || '-' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">状态</span>
          <span class="detail-value"><span class="badge <%= hazard.status === '正常' ? 'badge-success' : 'badge-warning' %>"><%= hazard.status %></span></span>
        </div>
      </div>
      <div class="detail-full">
        <div class="detail-item">
          <span class="detail-label">风险短语</span>
          <span class="detail-value"><%= hazard.risk_phrase || '-' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">安全短语</span>
          <span class="detail-value"><%= hazard.safety_phrase || '-' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">储存条件</span>
          <span class="detail-value"><%= hazard.storage_condition || '-' %></span>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>出入库操作</h2>
      <form action="/hazards/<%= hazard.id %>/log" method="POST" class="inline-form">
        <select name="action" required>
          <option value="入库">入库</option>
          <option value="领用">领用</option>
        </select>
        <input type="number" name="quantity" min="1" required placeholder="数量">
        <input type="text" name="remark" placeholder="备注（必填领用事由）">
        <button type="submit" class="btn btn-primary">提交</button>
      </form>
    </div>

    <div class="section">
      <h2>操作记录</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>时间</th>
            <th>操作</th>
            <th>数量</th>
            <th>备注</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function(log) { %>
            <tr>
              <td><%= log.created_at %></td>
              <td><span class="badge <%= log.action === '入库' ? 'badge-success' : 'badge-danger' %>"><%= log.action %></span></td>
              <td><%= log.quantity %></td>
              <td><%= log.remark || '-' %></td>
            </tr>
          <% }) %>
          <% if (logs.length === 0) { %>
            <tr><td colspan="4" class="text-center">暂无操作记录</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
  <footer class="footer"><p>&copy; 2026 实验室试剂与仪器管控平台</p></footer>
</body>
</html>
