<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= experiment.title %> - 实验详情 - 实验室试剂与仪器管控平台</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">实验室管控平台</a></div>
    <div class="nav-links">
      <a href="/dashboard">首页</a>
      <a href="/reagents">试剂管理</a>
      <a href="/hazards">危化品台账</a>
      <a href="/instruments">仪器预约</a>
      <a href="/experiments" class="active">实验记录</a>
    </div>
    <div class="nav-user">
      <span class="user-info"><%= session.realName %></span>
      <a href="/auth/logout" class="btn-logout">退出</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <h1><%= experiment.title %></h1>
      <div>
        <% if (experiment.status !== '已完成') { %>
          <form action="/experiments/<%= experiment.id %>/status" method="POST" class="inline-form">
            <% if (experiment.status === '草稿') { %>
              <button type="submit" name="status" value="进行中" class="btn btn-primary">开始实验</button>
            <% } else if (experiment.status === '进行中') { %>
              <button type="submit" name="status" value="已完成" class="btn btn-primary">完成实验</button>
            <% } %>
          </form>
        <% } %>
        <a href="/experiments" class="btn">返回列表</a>
      </div>
    </div>
    <div class="detail-card">
      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">分类</span>
          <span class="detail-value"><%= experiment.category %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">记录人</span>
          <span class="detail-value"><%= experiment.user_name %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">状态</span>
          <span class="detail-value"><span class="badge <%= experiment.status === '已完成' ? 'badge-success' : experiment.status === '进行中' ? 'badge-info' : 'badge-warning' %>"><%= experiment.status %></span></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">创建时间</span>
          <span class="detail-value"><%= experiment.created_at %></span>
        </div>
      </div>
      <div class="detail-full">
        <div class="detail-item">
          <span class="detail-label">实验描述</span>
          <span class="detail-value"><%= experiment.description || '-' %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">实验步骤</span>
          <pre class="detail-pre"><%= experiment.procedure || '-' %></pre>
        </div>
        <div class="detail-item">
          <span class="detail-label">实验结果</span>
          <pre class="detail-pre"><%= experiment.result || '-' %></pre>
        </div>
        <div class="detail-item">
          <span class="detail-label">结论</span>
          <span class="detail-value"><%= experiment.conclusion || '-' %></span>
        </div>
      </div>
    </div>
  </main>
  <footer class="footer"><p>&copy; 2026 实验室试剂与仪器管控平台</p></footer>
</body>
</html>
